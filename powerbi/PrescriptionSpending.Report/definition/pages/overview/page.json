{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/1.0.0/schema.json",
  "name": "overview",
  "displayName": "01  Spending overview",
  "displayOption": "FitToPage",
  "width": 1440,
  "height": 900,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F8FAFC'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  },
  "visualInteractions": [
    {
      "source": "year_filter",
      "target": "history",
      "type": "NoFilter"
    }
  ]
}
